// Hotel PMS: Phase 1 (Foundation) schema
//
// Conventions
//  - Every tenant-owned table carries organization_id (indexed, first column of composite indexes).
//  - Row-Level Security policies live in prisma/sql/rls.sql (Prisma cannot express them).
//  - Soft delete (deleted_at) on organizations, groups, properties, users.
//  - audit_logs is append-only (enforced by GRANTs in rls.sql).
//  - DB columns are snake_case; Prisma fields are camelCase.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- enums

enum OrganizationStatus {
  ACTIVE
  SUSPENDED

  @@map("organization_status")
}

enum UserStatus {
  INVITED
  ACTIVE
  DISABLED

  @@map("user_status")
}

enum PropertyType {
  HOTEL
  RESORT
  BOUTIQUE
  INN
  HOSTEL
  SERVICED_APARTMENT
  VACATION_RENTAL

  @@map("property_type")
}

enum PropertyStatus {
  ACTIVE
  INACTIVE

  @@map("property_status")
}

enum ScopeType {
  ORGANIZATION
  GROUP
  PROPERTY

  @@map("scope_type")
}

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET

  @@map("auth_token_type")
}

enum ReservationStatus {
  INQUIRY
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW

  @@map("reservation_status")
}

enum ReservationSource {
  WALK_IN
  PHONE
  WEBSITE
  OTA
  GROUP
  CORPORATE
  TRAVEL_AGENT
  OTHER

  @@map("reservation_source")
}

enum FolioStatus {
  OPEN
  CLOSED

  @@map("folio_status")
}

enum FolioItemType {
  ROOM_CHARGE
  EXTRA_CHARGE
  TAX
  DISCOUNT
  ADJUSTMENT
  REVERSAL

  @@map("folio_item_type")
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  E_WALLET
  OTHER

  @@map("payment_method")
}

enum HousekeepingTaskType {
  CHECKOUT_CLEAN
  STAYOVER
  DEEP_CLEAN

  @@map("housekeeping_task_type")
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT

  @@map("task_priority")
}

enum HousekeepingStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  CLEANED
  DONE
  CANCELLED

  @@map("housekeeping_status")
}

enum MaintenanceCategory {
  AIRCON
  PLUMBING
  ELECTRICAL
  FURNITURE
  INTERNET
  APPLIANCE
  STRUCTURAL
  OTHER

  @@map("maintenance_category")
}

enum MaintenanceStatus {
  REPORTED
  ASSIGNED
  IN_PROGRESS
  WAITING_PARTS
  RESOLVED
  CLOSED

  @@map("maintenance_status")
}

enum InventoryCategory {
  FOOD
  BEVERAGE
  HOUSEKEEPING_SUPPLIES
  TOILETRIES
  LINENS
  OFFICE_SUPPLIES
  MAINTENANCE_MATERIALS

  @@map("inventory_category")
}

enum StockMovementType {
  OPENING
  PURCHASE_RECEIPT
  USAGE
  WASTAGE
  ADJUSTMENT
  TRANSFER_OUT
  TRANSFER_IN

  @@map("stock_movement_type")
}

enum PurchaseStatus {
  REQUESTED
  APPROVED
  REJECTED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED

  @@map("purchase_status")
}

enum InvoiceStatus {
  UNPAID
  PAID

  @@map("invoice_status")
}

enum ExpenseCategory {
  UTILITIES
  PAYROLL
  SUPPLIES
  MAINTENANCE
  MARKETING
  RENT
  INTERNET
  TRANSPORTATION
  INVENTORY
  OTHER

  @@map("expense_category")
}

enum OutletType {
  RESTAURANT
  BAR
  CAFE
  ROOM_SERVICE
  MINIBAR
  SPA
  LAUNDRY
  OTHER

  @@map("outlet_type")
}

enum PosOrderStatus {
  PAID
  ROOM_CHARGED
  VOID

  @@map("pos_order_status")
}

// Stored statuses only. OCCUPIED / RESERVED / DUE_OUT are derived from reservations (Phase 3).
enum RoomStatus {
  AVAILABLE
  DIRTY
  CLEANING
  CLEAN
  INSPECTED
  OUT_OF_ORDER
  OUT_OF_SERVICE
  MAINTENANCE

  @@map("room_status")
}

// ---------------------------------------------------------------- tenancy

model Organization {
  id        String             @id @default(uuid()) @db.Uuid
  name      String
  slug      String             @unique
  status    OrganizationStatus @default(ACTIVE)
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime           @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime?          @map("deleted_at") @db.Timestamptz

  propertyGroups PropertyGroup[]
  properties     Property[]
  departments    Department[]
  buildings      Building[]
  floors         Floor[]
  users          User[]
  sessions       UserSession[]
  authTokens     AuthToken[]
  roles          Role[]
  roleAssignments UserRoleAssignment[]
  auditLogs      AuditLog[]
  roomTypes      RoomType[]
  rooms          Room[]
  guests         Guest[]
  ratePlans      RatePlan[]
  ratePlanRates  RatePlanRate[]
  reservations   Reservation[]
  taxes          Tax[]
  folios         Folio[]
  folioItems     FolioItem[]
  payments       Payment[]
  refunds        Refund[]
  housekeepingTasks  HousekeepingTask[]
  maintenanceTickets MaintenanceTicket[]
  suppliers          Supplier[]
  inventoryItems     InventoryItem[]
  stockMovements     StockMovement[]
  purchaseOrders     PurchaseOrder[]
  purchaseLines      PurchaseOrderLine[]
  supplierInvoices   SupplierInvoice[]
  expenses           Expense[]
  posOutlets         PosOutlet[]
  posItems           PosItem[]
  posOrders          PosOrder[]
  posOrderLines      PosOrderLine[]

  @@map("organizations")
}

model PropertyGroup {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])
  properties   Property[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("property_groups")
}

model Property {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  groupId        String?        @map("group_id") @db.Uuid
  name           String
  slug           String
  type           PropertyType   @default(HOTEL)
  status         PropertyStatus @default(ACTIVE)
  addressLine1   String?        @map("address_line1")
  addressLine2   String?        @map("address_line2")
  city           String?
  region         String?
  country        String         @default("PH") @db.Char(2)
  postalCode     String?        @map("postal_code")
  phone          String?
  email          String?
  timezone       String         @default("Asia/Manila")
  currency       String         @default("PHP") @db.Char(3)
  checkInTime    String         @default("14:00") @map("check_in_time") @db.VarChar(5)
  checkOutTime   String         @default("12:00") @map("check_out_time") @db.VarChar(5)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt      DateTime?      @map("deleted_at") @db.Timestamptz

  organization Organization   @relation(fields: [organizationId], references: [id])
  group        PropertyGroup? @relation(fields: [groupId], references: [id])
  departments  Department[]
  buildings    Building[]
  roomTypes    RoomType[]
  rooms        Room[]
  ratePlans    RatePlan[]
  reservations Reservation[]
  taxes        Tax[]
  folios       Folio[]
  housekeepingTasks  HousekeepingTask[]
  maintenanceTickets MaintenanceTicket[]
  stockMovements     StockMovement[]
  purchaseOrders     PurchaseOrder[]
  supplierInvoices   SupplierInvoice[]
  expenses           Expense[]
  posOutlets         PosOutlet[]
  posOrders          PosOrder[]

  @@unique([organizationId, slug])
  @@index([organizationId, groupId])
  @@index([organizationId, status])
  @@map("properties")
}

model Department {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  propertyId     String   @map("property_id") @db.Uuid
  name           String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])
  property     Property     @relation(fields: [propertyId], references: [id])
  expenses     Expense[]

  @@unique([propertyId, name])
  @@index([organizationId])
  @@map("departments")
}

// Buildings/floors: tables exist now so Phase 2 (rooms) needs no restructuring.
// No API or UI for them until Phase 2.
model Building {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  propertyId     String   @map("property_id") @db.Uuid
  name           String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])
  property     Property     @relation(fields: [propertyId], references: [id])
  floors       Floor[]

  @@unique([propertyId, name])
  @@index([organizationId])
  @@map("buildings")
}

model Floor {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  buildingId     String   @map("building_id") @db.Uuid
  level          Int
  name           String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])
  building     Building     @relation(fields: [buildingId], references: [id])
  rooms        Room[]

  @@unique([buildingId, level])
  @@index([organizationId])
  @@map("floors")
}

// ---------------------------------------------------------------- identity

model User {
  id               String     @id @default(uuid()) @db.Uuid
  organizationId   String     @map("organization_id") @db.Uuid
  // Email is globally unique so login needs no organization slug.
  // Always store lower-cased (normalised in the service layer).
  email            String     @unique
  passwordHash     String     @map("password_hash")
  firstName        String     @map("first_name")
  lastName         String     @map("last_name")
  phone            String?
  status           UserStatus @default(INVITED)
  emailVerifiedAt  DateTime?  @map("email_verified_at") @db.Timestamptz
  // MFA columns exist for a later phase. Not used yet.
  mfaSecret        String?    @map("mfa_secret")
  mfaEnabled       Boolean    @default(false) @map("mfa_enabled")
  failedLoginCount Int        @default(0) @map("failed_login_count")
  lockedUntil      DateTime?  @map("locked_until") @db.Timestamptz
  lastLoginAt      DateTime?  @map("last_login_at") @db.Timestamptz
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt        DateTime?  @map("deleted_at") @db.Timestamptz

  organization    Organization         @relation(fields: [organizationId], references: [id])
  sessions        UserSession[]
  authTokens      AuthToken[]
  roleAssignments UserRoleAssignment[]
  auditLogs       AuditLog[]
  assignedTasks   HousekeepingTask[]  @relation("TaskAssignee")
  assignedTickets MaintenanceTicket[] @relation("TicketAssignee")
  reportedTickets MaintenanceTicket[] @relation("TicketReporter")

  @@index([organizationId, status])
  @@map("users")
}

model UserSession {
  id               String    @id @default(uuid()) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  // All tokens descended from one login share a family; reuse of an old token revokes the family.
  familyId         String    @map("family_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash")
  deviceLabel      String?   @map("device_label")
  ip               String?
  userAgent        String?   @map("user_agent")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  lastUsedAt       DateTime  @default(now()) @map("last_used_at") @db.Timestamptz
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([userId, revokedAt])
  @@index([familyId])
  @@map("user_sessions")
}

model AuthToken {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  userId         String        @map("user_id") @db.Uuid
  type           AuthTokenType
  tokenHash      String        @unique @map("token_hash")
  expiresAt      DateTime      @map("expires_at") @db.Timestamptz
  usedAt         DateTime?     @map("used_at") @db.Timestamptz
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([userId, type])
  @@map("auth_tokens")
}

// ---------------------------------------------------------------- RBAC

model Role {
  id             String   @id @default(uuid()) @db.Uuid
  // NULL = system role shared by every organization (read-only for tenants).
  organizationId String?  @map("organization_id") @db.Uuid
  key            String
  name           String
  description    String?
  isSystem       Boolean  @default(false) @map("is_system")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization    Organization?        @relation(fields: [organizationId], references: [id])
  permissions     RolePermission[]
  assignments     UserRoleAssignment[]

  // Postgres treats NULLs as distinct, so system-role key uniqueness
  // is enforced by a partial unique index in prisma/sql/rls.sql.
  @@unique([organizationId, key])
  @@index([organizationId])
  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  key         String  @unique // e.g. "property.update"
  module      String
  description String?

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRoleAssignment {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  roleId         String    @map("role_id") @db.Uuid
  scopeType      ScopeType @map("scope_type")
  // ORGANIZATION scope -> the organization id, GROUP -> group id, PROPERTY -> property id.
  // Never NULL, so the unique constraint below works as intended.
  scopeId        String    @map("scope_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId, scopeType, scopeId])
  @@index([organizationId])
  @@index([userId])
  @@index([scopeType, scopeId])
  @@map("user_role_assignments")
}

// ---------------------------------------------------------------- audit

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  propertyId     String?  @map("property_id") @db.Uuid
  actorId        String?  @map("actor_id") @db.Uuid
  action         String // e.g. "property.update", "user.role_assigned"
  entity         String
  entityId       String?  @map("entity_id")
  before         Json?
  after          Json?
  ip             String?
  userAgent      String?  @map("user_agent")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])
  actor        User?        @relation(fields: [actorId], references: [id])

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, entity, entityId])
  @@index([organizationId, propertyId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

// ---------------------------------------------------------------- rooms (Phase 2)

model RoomType {
  id               String    @id @default(uuid()) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  propertyId       String    @map("property_id") @db.Uuid
  name             String
  description      String?
  maxOccupancy     Int       @default(2) @map("max_occupancy")
  bedConfiguration String?   @map("bed_configuration")
  amenities        String[]  @default([])
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])
  property     Property     @relation(fields: [propertyId], references: [id])
  rooms        Room[]
  rates        RatePlanRate[]
  reservations Reservation[]

  // Name uniqueness among non-archived types is a partial unique index in prisma/sql/rls.sql.
  @@index([organizationId])
  @@index([propertyId])
  @@map("room_types")
}

model Room {
  id              String     @id @default(uuid()) @db.Uuid
  organizationId  String     @map("organization_id") @db.Uuid
  propertyId      String     @map("property_id") @db.Uuid
  roomTypeId      String     @map("room_type_id") @db.Uuid
  floorId         String?    @map("floor_id") @db.Uuid
  number          String
  status          RoomStatus @default(AVAILABLE)
  statusNote      String?    @map("status_note")
  statusChangedAt DateTime   @default(now()) @map("status_changed_at") @db.Timestamptz
  notes           String?
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt       DateTime?  @map("deleted_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])
  property     Property     @relation(fields: [propertyId], references: [id])
  roomType     RoomType     @relation(fields: [roomTypeId], references: [id])
  floor        Floor?       @relation(fields: [floorId], references: [id])
  reservations Reservation[]
  housekeepingTasks  HousekeepingTask[]
  maintenanceTickets MaintenanceTicket[]

  // Room number uniqueness among non-archived rooms is a partial unique index in prisma/sql/rls.sql.
  @@index([organizationId, propertyId, status])
  @@index([propertyId, roomTypeId])
  @@index([floorId])
  @@map("rooms")
}

// ---------------------------------------------------------------- guests, rates, reservations (Phase 3)

// Guests belong to the ORGANIZATION (one profile across all its properties).
model Guest {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  firstName      String    @map("first_name")
  lastName       String    @map("last_name")
  email          String?
  phone          String?
  country        String?   @db.Char(2)
  preferences    String?
  notes          String?
  isVip          Boolean   @default(false) @map("is_vip")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz

  organization Organization  @relation(fields: [organizationId], references: [id])
  reservations Reservation[]

  // Email uniqueness among non-archived guests is a partial unique index in prisma/sql/rls.sql.
  @@index([organizationId, lastName])
  @@index([organizationId, email])
  @@map("guests")
}

model RatePlan {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  propertyId     String    @map("property_id") @db.Uuid
  name           String
  description    String?
  isDefault      Boolean   @default(false) @map("is_default")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz

  organization Organization   @relation(fields: [organizationId], references: [id])
  property     Property       @relation(fields: [propertyId], references: [id])
  rates        RatePlanRate[]
  reservations Reservation[]

  @@index([organizationId])
  @@index([propertyId])
  @@map("rate_plans")
}

/// Money is stored as whole minor units (centavos). Never decimals.
model RatePlanRate {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  ratePlanId       String   @map("rate_plan_id") @db.Uuid
  roomTypeId       String   @map("room_type_id") @db.Uuid
  nightlyRateMinor Int      @map("nightly_rate_minor")
  weekendRateMinor Int?     @map("weekend_rate_minor")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])
  ratePlan     RatePlan     @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)
  roomType     RoomType     @relation(fields: [roomTypeId], references: [id])

  @@unique([ratePlanId, roomTypeId])
  @@index([organizationId])
  @@map("rate_plan_rates")
}

model Reservation {
  id              String            @id @default(uuid()) @db.Uuid
  organizationId  String            @map("organization_id") @db.Uuid
  propertyId      String            @map("property_id") @db.Uuid
  code            String
  guestId         String            @map("guest_id") @db.Uuid
  roomTypeId      String            @map("room_type_id") @db.Uuid
  roomId          String?           @map("room_id") @db.Uuid
  ratePlanId      String?           @map("rate_plan_id") @db.Uuid
  status          ReservationStatus @default(CONFIRMED)
  source          ReservationSource @default(PHONE)
  /// Stay dates, no time of day. Departure date is the check-out day (that night is NOT part of the stay).
  arrivalDate     DateTime          @map("arrival_date") @db.Date
  departureDate   DateTime          @map("departure_date") @db.Date
  adults          Int               @default(1)
  children        Int               @default(0)
  nights          Int
  totalMinor      Int               @map("total_minor")
  /// Per-night prices (whole minor units) at booking time, so billing honours the quoted price.
  nightlyRates    Json?             @map("nightly_rates")
  currency        String            @db.Char(3)
  specialRequests String?           @map("special_requests")
  notes           String?
  cancelReason    String?           @map("cancel_reason")
  cancelledAt     DateTime?         @map("cancelled_at") @db.Timestamptz
  checkedInAt     DateTime?         @map("checked_in_at") @db.Timestamptz
  checkedOutAt    DateTime?         @map("checked_out_at") @db.Timestamptz
  createdById     String?           @map("created_by_id") @db.Uuid
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])
  property     Property     @relation(fields: [propertyId], references: [id])
  guest        Guest        @relation(fields: [guestId], references: [id])
  roomType     RoomType     @relation(fields: [roomTypeId], references: [id])
  room         Room?        @relation(fields: [roomId], references: [id])
  ratePlan     RatePlan?    @relation(fields: [ratePlanId], references: [id])
  folio        Folio?
  posOrders    PosOrder[]

  // DB-level guards (prisma/sql/rls.sql): no two active stays may overlap on the same room (exclusion
  // constraint), departure must be after arrival, adults >= 1, total >= 0.
  @@unique([organizationId, code])
  @@index([organizationId, propertyId, arrivalDate])
  @@index([propertyId, status])
  @@index([guestId])
  @@index([roomId])
  @@map("reservations")
}

// ---------------------------------------------------------------- billing (Phase 3b)
// The ledger is APPEND-ONLY: folio_items, payments and refunds can be inserted but never updated or deleted
// by the application role (see prisma/sql/rls.sql). Mistakes are fixed with reversing entries.

/// Percentage taxes and service charges per property. Rate in basis points: 1200 = 12%.
model Tax {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  propertyId      String    @map("property_id") @db.Uuid
  name            String
  rateBps         Int       @map("rate_bps")
  appliesToRoom   Boolean   @default(true) @map("applies_to_room")
  appliesToExtras Boolean   @default(true) @map("applies_to_extras")
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])
  property     Property     @relation(fields: [propertyId], references: [id])

  @@index([organizationId])
  @@index([propertyId])
  @@map("taxes")
}

model Folio {
  id                  String      @id @default(uuid()) @db.Uuid
  organizationId      String      @map("organization_id") @db.Uuid
  propertyId          String      @map("property_id") @db.Uuid
  reservationId       String      @unique @map("reservation_id") @db.Uuid
  status              FolioStatus @default(OPEN)
  currency            String      @db.Char(3)
  roomChargesPostedAt DateTime?   @map("room_charges_posted_at") @db.Timestamptz
  closedAt            DateTime?   @map("closed_at") @db.Timestamptz
  createdAt           DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])
  property     Property     @relation(fields: [propertyId], references: [id])
  reservation  Reservation  @relation(fields: [reservationId], references: [id])
  items        FolioItem[]
  payments     Payment[]

  @@index([organizationId, propertyId])
  @@map("folios")
}

/// amount_minor = quantity * unit_amount_minor (checked in SQL). Positive = charge, negative = credit.
model FolioItem {
  id              String        @id @default(uuid()) @db.Uuid
  organizationId  String        @map("organization_id") @db.Uuid
  folioId         String        @map("folio_id") @db.Uuid
  type            FolioItemType
  description     String
  serviceDate     DateTime?     @map("service_date") @db.Date
  quantity        Int           @default(1)
  unitAmountMinor Int           @map("unit_amount_minor")
  amountMinor     Int           @map("amount_minor")
  /// A TAX line points at the charge it was calculated on.
  parentItemId    String?       @map("parent_item_id") @db.Uuid
  taxId           String?       @map("tax_id") @db.Uuid
  /// A REVERSAL line points at the line it cancels. Unique: a line can be reversed only once.
  reversesItemId  String?       @unique @map("reverses_item_id") @db.Uuid
  reason          String?
  source          String        @default("FRONT_DESK")
  idempotencyKey  String?       @map("idempotency_key")
  createdById     String?       @map("created_by_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])
  folio        Folio        @relation(fields: [folioId], references: [id])
  parent       FolioItem?   @relation("ItemTax", fields: [parentItemId], references: [id])
  taxLines     FolioItem[]  @relation("ItemTax")
  reverses     FolioItem?   @relation("ItemReversal", fields: [reversesItemId], references: [id])
  reversedBy   FolioItem?   @relation("ItemReversal")

  @@unique([organizationId, idempotencyKey])
  @@index([folioId])
  @@index([organizationId])
  @@map("folio_items")
}

model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  folioId        String        @map("folio_id") @db.Uuid
  amountMinor    Int           @map("amount_minor")
  method         PaymentMethod
  reference      String?
  note           String?
  idempotencyKey String?       @map("idempotency_key")
  receivedById   String?       @map("received_by_id") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])
  folio        Folio        @relation(fields: [folioId], references: [id])
  refunds      Refund[]

  @@unique([organizationId, idempotencyKey])
  @@index([folioId])
  @@index([organizationId])
  @@map("payments")
}

model Refund {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  paymentId      String   @map("payment_id") @db.Uuid
  amountMinor    Int      @map("amount_minor")
  reason         String
  idempotencyKey String?  @map("idempotency_key")
  createdById    String?  @map("created_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])
  payment      Payment      @relation(fields: [paymentId], references: [id])

  @@unique([organizationId, idempotencyKey])
  @@index([paymentId])
  @@index([organizationId])
  @@map("refunds")
}

// ---------------------------------------------------------------- operations (Phase 4)

/// One open task per room and type is enforced by a partial unique index in prisma/sql/rls.sql.
model HousekeepingTask {
  id               String                   @id @default(uuid()) @db.Uuid
  organizationId   String                   @map("organization_id") @db.Uuid
  propertyId       String                   @map("property_id") @db.Uuid
  roomId           String                   @map("room_id") @db.Uuid
  type             HousekeepingTaskType
  status           HousekeepingStatus       @default(OPEN)
  priority         TaskPriority             @default(NORMAL)
  assignedToId     String?                  @map("assigned_to_id") @db.Uuid
  assignedAt       DateTime?                @map("assigned_at") @db.Timestamptz
  estimatedMinutes Int?                     @map("estimated_minutes")
  notes            String?
  startedAt        DateTime?                @map("started_at") @db.Timestamptz
  cleanedAt        DateTime?                @map("cleaned_at") @db.Timestamptz
  completedAt      DateTime?                @map("completed_at") @db.Timestamptz
  createdById      String?                  @map("created_by_id") @db.Uuid
  createdAt        DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime                 @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])
  property     Property     @relation(fields: [propertyId], references: [id])
  room         Room         @relation(fields: [roomId], references: [id])
  assignedTo   User?        @relation("TaskAssignee", fields: [assignedToId], references: [id])

  @@index([organizationId, propertyId, status])
  @@index([roomId])
  @@index([assignedToId])
  @@map("housekeeping_tasks")
}

model MaintenanceTicket {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  propertyId     String              @map("property_id") @db.Uuid
  roomId         String?             @map("room_id") @db.Uuid
  title          String
  description    String?
  category       MaintenanceCategory
  priority       TaskPriority        @default(NORMAL)
  status         MaintenanceStatus   @default(REPORTED)
  /// While open, the room is held out of the available pool (room status MAINTENANCE).
  blocksRoom     Boolean             @default(false) @map("blocks_room")
  assignedToId   String?             @map("assigned_to_id") @db.Uuid
  reportedById   String?             @map("reported_by_id") @db.Uuid
  costMinor      Int                 @default(0) @map("cost_minor")
  minutesSpent   Int                 @default(0) @map("minutes_spent")
  partsUsed      String?             @map("parts_used")
  resolutionNote String?             @map("resolution_note")
  assignedAt     DateTime?           @map("assigned_at") @db.Timestamptz
  startedAt      DateTime?           @map("started_at") @db.Timestamptz
  resolvedAt     DateTime?           @map("resolved_at") @db.Timestamptz
  closedAt       DateTime?           @map("closed_at") @db.Timestamptz
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])
  property     Property     @relation(fields: [propertyId], references: [id])
  room         Room?        @relation(fields: [roomId], references: [id])
  assignedTo   User?        @relation("TicketAssignee", fields: [assignedToId], references: [id])
  reportedBy   User?        @relation("TicketReporter", fields: [reportedById], references: [id])

  @@index([organizationId, propertyId, status])
  @@index([roomId])
  @@index([assignedToId])
  @@map("maintenance_tickets")
}

// ---------------------------------------------------------------- inventory, purchasing, expenses (Phase 5a)
// Stock is a LEDGER: stock_movements can be inserted but never changed or deleted by the application.
// On-hand stock is the sum of a property's movements. Money is whole minor units (centavos).

model Supplier {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String
  contactName    String?   @map("contact_name")
  email          String?
  phone          String?
  address        String?
  notes          String?
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz

  organization Organization      @relation(fields: [organizationId], references: [id])
  orders       PurchaseOrder[]
  invoices     SupplierInvoice[]
  expenses     Expense[]

  // Name uniqueness among live suppliers is a partial unique index in prisma/sql/rls.sql.
  @@index([organizationId])
  @@map("suppliers")
}

/// The item catalog is shared by the whole organization (so stock can be transferred between properties).
model InventoryItem {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  sku            String
  name           String
  category       InventoryCategory
  unit           String
  /// Thresholds apply to each property's own stock.
  minStock       Int               @default(0) @map("min_stock")
  maxStock       Int               @default(0) @map("max_stock")
  unitCostMinor  Int               @default(0) @map("unit_cost_minor")
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt      DateTime?         @map("deleted_at") @db.Timestamptz

  organization Organization        @relation(fields: [organizationId], references: [id])
  movements    StockMovement[]
  orderLines   PurchaseOrderLine[]
  posItems     PosItem[]

  // SKU uniqueness among live items is a partial unique index in prisma/sql/rls.sql.
  @@index([organizationId])
  @@map("inventory_items")
}

/// quantity is SIGNED (non-zero, checked in SQL): + adds stock, - removes it.
model StockMovement {
  id              String            @id @default(uuid()) @db.Uuid
  organizationId  String            @map("organization_id") @db.Uuid
  propertyId      String            @map("property_id") @db.Uuid
  itemId          String            @map("item_id") @db.Uuid
  type            StockMovementType
  quantity        Int
  unitCostMinor   Int?              @map("unit_cost_minor")
  note            String?
  /// Both legs of a transfer share this id.
  transferId      String?           @map("transfer_id") @db.Uuid
  purchaseOrderId String?           @map("purchase_order_id") @db.Uuid
  createdById     String?           @map("created_by_id") @db.Uuid
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz

  organization  Organization   @relation(fields: [organizationId], references: [id])
  property      Property       @relation(fields: [propertyId], references: [id])
  item          InventoryItem  @relation(fields: [itemId], references: [id])
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])

  @@index([organizationId, propertyId, itemId])
  @@index([transferId])
  @@index([purchaseOrderId])
  @@map("stock_movements")
}

model PurchaseOrder {
  id            String         @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  propertyId    String         @map("property_id") @db.Uuid
  code          String
  supplierId    String         @map("supplier_id") @db.Uuid
  status        PurchaseStatus @default(REQUESTED)
  notes         String?
  currency      String         @db.Char(3)
  /// Fixed when the request is made; lines are never repriced.
  totalMinor    Int            @map("total_minor")
  requestedById String?        @map("requested_by_id") @db.Uuid
  requestedAt   DateTime       @default(now()) @map("requested_at") @db.Timestamptz
  approvedById  String?        @map("approved_by_id") @db.Uuid
  decidedAt     DateTime?      @map("decided_at") @db.Timestamptz
  decisionNote  String?        @map("decision_note")
  receivedAt    DateTime?      @map("received_at") @db.Timestamptz
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization        @relation(fields: [organizationId], references: [id])
  property     Property            @relation(fields: [propertyId], references: [id])
  supplier     Supplier            @relation(fields: [supplierId], references: [id])
  lines        PurchaseOrderLine[]
  invoice      SupplierInvoice?
  movements    StockMovement[]

  @@unique([organizationId, code])
  @@index([organizationId, propertyId, status])
  @@index([supplierId])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  purchaseOrderId  String   @map("purchase_order_id") @db.Uuid
  itemId           String   @map("item_id") @db.Uuid
  quantity         Int
  unitCostMinor    Int      @map("unit_cost_minor")
  receivedQuantity Int      @default(0) @map("received_quantity")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  organization  Organization  @relation(fields: [organizationId], references: [id])
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  item          InventoryItem @relation(fields: [itemId], references: [id])

  @@unique([purchaseOrderId, itemId])
  @@index([organizationId])
  @@map("purchase_order_lines")
}

model SupplierInvoice {
  id                 String        @id @default(uuid()) @db.Uuid
  organizationId     String        @map("organization_id") @db.Uuid
  propertyId         String        @map("property_id") @db.Uuid
  purchaseOrderId    String        @unique @map("purchase_order_id") @db.Uuid
  supplierId         String        @map("supplier_id") @db.Uuid
  number             String
  amountMinor        Int           @map("amount_minor")
  /// Value of the goods received when the invoice was recorded (the "three-way match").
  receivedValueMinor Int           @map("received_value_minor")
  issuedOn           DateTime      @map("issued_on") @db.Date
  dueOn              DateTime      @map("due_on") @db.Date
  status             InvoiceStatus @default(UNPAID)
  paidAt             DateTime?     @map("paid_at") @db.Timestamptz
  paidMethod         PaymentMethod? @map("paid_method")
  paidReference      String?       @map("paid_reference")
  createdById        String?       @map("created_by_id") @db.Uuid
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz

  organization  Organization  @relation(fields: [organizationId], references: [id])
  property      Property      @relation(fields: [propertyId], references: [id])
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  supplier      Supplier      @relation(fields: [supplierId], references: [id])
  expense       Expense?

  @@index([organizationId, propertyId, status])
  @@map("supplier_invoices")
}

model Expense {
  id                String          @id @default(uuid()) @db.Uuid
  organizationId    String          @map("organization_id") @db.Uuid
  propertyId        String          @map("property_id") @db.Uuid
  departmentId      String?         @map("department_id") @db.Uuid
  category          ExpenseCategory
  vendor            String?
  supplierId        String?         @map("supplier_id") @db.Uuid
  incurredOn        DateTime        @map("incurred_on") @db.Date
  amountMinor       Int             @map("amount_minor")
  paymentMethod     PaymentMethod   @map("payment_method")
  reference         String?
  note              String?
  /// MANUAL, or PURCHASING when created by paying a supplier invoice.
  source            String          @default("MANUAL")
  supplierInvoiceId String?         @unique @map("supplier_invoice_id") @db.Uuid
  voidedAt          DateTime?       @map("voided_at") @db.Timestamptz
  voidReason        String?         @map("void_reason")
  createdById       String?         @map("created_by_id") @db.Uuid
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz

  organization    Organization     @relation(fields: [organizationId], references: [id])
  property        Property         @relation(fields: [propertyId], references: [id])
  department      Department?      @relation(fields: [departmentId], references: [id])
  supplier        Supplier?        @relation(fields: [supplierId], references: [id])
  supplierInvoice SupplierInvoice? @relation(fields: [supplierInvoiceId], references: [id])

  @@index([organizationId, propertyId, incurredOn])
  @@index([category])
  @@map("expenses")
}

// ---------------------------------------------------------------- point of sale (Phase 5b)
// A sale is IMMUTABLE once made: order lines can be inserted but never changed, and an order can only be voided
// (with a reason) by someone allowed to. A room charge is posted to the guest's folio in the same transaction.

model PosOutlet {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  propertyId     String     @map("property_id") @db.Uuid
  name           String
  type           OutletType
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt      DateTime?  @map("deleted_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])
  property     Property     @relation(fields: [propertyId], references: [id])
  items        PosItem[]
  orders       PosOrder[]

  // Name uniqueness per property among live outlets is a partial unique index in prisma/sql/rls.sql.
  @@index([organizationId, propertyId])
  @@map("pos_outlets")
}

model PosItem {
  id                String    @id @default(uuid()) @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  outletId          String    @map("outlet_id") @db.Uuid
  name              String
  category          String?
  priceMinor        Int       @map("price_minor")
  taxable           Boolean   @default(true)
  /// When set, each sale uses up inventoryQuantity of this stock item (and is refused if there is not enough).
  inventoryItemId   String?   @map("inventory_item_id") @db.Uuid
  inventoryQuantity Int       @default(1) @map("inventory_quantity")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz

  organization  Organization   @relation(fields: [organizationId], references: [id])
  outlet        PosOutlet      @relation(fields: [outletId], references: [id])
  inventoryItem InventoryItem? @relation(fields: [inventoryItemId], references: [id])

  @@index([organizationId, outletId])
  @@map("pos_items")
}

model PosOrder {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  propertyId     String         @map("property_id") @db.Uuid
  outletId       String         @map("outlet_id") @db.Uuid
  code           String
  status         PosOrderStatus
  tableLabel     String?        @map("table_label")
  note           String?
  /// Set for a room charge (the guest it was billed to).
  reservationId  String?        @map("reservation_id") @db.Uuid
  /// Set for a counter sale paid now.
  paymentMethod  PaymentMethod? @map("payment_method")
  subtotalMinor  Int            @map("subtotal_minor")
  taxMinor       Int            @map("tax_minor")
  totalMinor     Int            @map("total_minor")
  currency       String         @db.Char(3)
  /// Stops a double-click or a retry from creating the same sale twice.
  idempotencyKey String?        @map("idempotency_key")
  createdById    String?        @map("created_by_id") @db.Uuid
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz
  voidedAt       DateTime?      @map("voided_at") @db.Timestamptz
  voidedById     String?        @map("voided_by_id") @db.Uuid
  voidReason     String?        @map("void_reason")

  organization Organization   @relation(fields: [organizationId], references: [id])
  property     Property       @relation(fields: [propertyId], references: [id])
  outlet       PosOutlet      @relation(fields: [outletId], references: [id])
  reservation  Reservation?   @relation(fields: [reservationId], references: [id])
  lines        PosOrderLine[]

  @@unique([organizationId, code])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, propertyId, createdAt])
  @@index([reservationId])
  @@map("pos_orders")
}

model PosOrderLine {
  id                String   @id @default(uuid()) @db.Uuid
  organizationId    String   @map("organization_id") @db.Uuid
  orderId           String   @map("order_id") @db.Uuid
  posItemId         String?  @map("pos_item_id") @db.Uuid
  /// What was sold and at what price, frozen at the moment of sale.
  description       String
  quantity          Int
  unitAmountMinor   Int      @map("unit_amount_minor")
  amountMinor       Int      @map("amount_minor")
  taxable           Boolean
  taxMinor          Int      @map("tax_minor")
  /// Stock used by this line (so a void can put it back).
  inventoryItemId   String?  @map("inventory_item_id") @db.Uuid
  inventoryQuantity Int      @default(0) @map("inventory_quantity")
  /// For a room charge: the folio line this became (so a void can reverse it).
  folioItemId       String?  @map("folio_item_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])
  order        PosOrder     @relation(fields: [orderId], references: [id])

  @@index([organizationId])
  @@index([orderId])
  @@map("pos_order_lines")
}
