
# --- Phase 7 (integrations) ---
# Email: console = print emails in the API console. resend = really send them (needs a resend.com account and a verified domain).
MAIL_PROVIDER=console
# RESEND_API_KEY=re_xxxxxxxx
# MAIL_FROM="Hotel PMS <noreply@yourdomain.com>"
# Encrypts stored secrets. REQUIRED in production. Generate: openssl rand -hex 32   (PowerShell: -join ((1..32) | % { '{0:x2}' -f (Get-Random -Max 256) }))
# DATA_ENCRYPTION_KEY=
# How often the webhook worker runs, in milliseconds (0 = off).
WEBHOOK_DISPATCH_INTERVAL_MS=5000
