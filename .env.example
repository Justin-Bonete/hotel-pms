# --- Database ---
# Owner role: used ONLY for migrations and seeding (bypasses RLS).
DATABASE_URL=postgresql://pms_owner:pms_owner_dev@localhost:5432/hotel_pms?schema=public
# Runtime role: used by the API. Subject to Row-Level Security. Never the owner.
APP_DATABASE_URL=postgresql://pms_app:pms_app_dev@localhost:5432/hotel_pms?schema=public

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- API ---
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
# Generate real values: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# --- Seed (dev only) ---
SEED_OWNER_EMAIL=bonetejustin29@gmail.com
SEED_OWNER_PASSWORD=ChangeMe!12345

# Set true only when behind a reverse proxy (so rate limits see real client IPs)
TRUST_PROXY=false
